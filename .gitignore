# OS files
.DS_Store
Thumbs.db

# Editor state
*.swp
*.swo
*~

# Node tooling (dev-only; never committed, never distributed).
# package-lock.json IS committed for reproducible CI installs.
node_modules/
npm-debug.log*

# Cross Stitch Lens build output & generated artifacts (from M0/M5).
dist/
.vite/
crates/stitch-engine/pkg/
crates/stitch-engine/target/

# Benchmark reports (M5-PERF-03): machine-specific measurement output,
# regenerated by `npm run bench`. Cite a report in the decision-log;
# never commit the raw files.
bench-reports/

# Environment / secrets (none required today; ignore pre-emptively).
# .env.example is committed with placeholders only.
.env
.env.*
!.env.example

# User scratch / raw input drops (init source suite, spreadsheets).
# Not a project deliverable; the canonical palette data lives tracked in
# src/core/palettes/. Kept on disk, out of version control and linting.
_user-guff/

# Saved chat-session transcripts (AGENTS.md → read tiers; GUIDE.md →
# "Saving session transcripts"). Evidence for prompt-tuning, kept
# local: a transcript carries whatever was on screen during the
# session, so it never lands in the repo unredacted. The folder and
# its README are tracked; the transcripts themselves are not.
_transcripts/*.md
!_transcripts/README.md
