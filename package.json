{
  "name": "cross-stitch-lens",
  "private": true,
  "description": "Cross Stitch Lens. Interim docs-lint gate inherited from the pm-skills source repo; replaced by the app's own scaffold (Vite/TS/ESLint/Vitest) in M0.",
  "scripts": {
    "lint": "npm run lint:md && npm run lint:docs && npm run lint:spell && npm run lint:editorconfig",
    "lint:md": "npx --yes markdownlint-cli2 \"**/*.md\"",
    "lint:fix": "npx --yes markdownlint-cli2 --fix \"**/*.md\"",
    "lint:docs": "node scripts/check-docs.mjs",
    "lint:spell": "npx --yes cspell \"**/*.md\"",
    "lint:editorconfig": "npx --yes editorconfig-checker",
    "check": "npm run lint",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "cspell": "^10.0.1",
    "editorconfig-checker": "^6.1.1",
    "markdownlint-cli2": "^0.22.1"
  },
  "overrides": {
    "js-yaml": "^4.2.0",
    "markdown-it": "^14.2.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/djDAOjones/cross-stitch-lens.git"
  }
}
